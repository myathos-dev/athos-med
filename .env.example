# Copy this file to .env and fill in your own values. Never commit .env.

# Port the web app runs on
PORT=3000

# Local development sign-in (who the app treats as the logged-in user)
DEV_USER_ID=local-user
DEV_USER_NAME=Local User
DEV_USER_EMAIL=
# "Admin" sees everything; any other value sees only records assigned to this user
DEV_USER_ROLE=Admin
